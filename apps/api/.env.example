# ---------------------------------------------------------------------------
# Salin file ini menjadi `apps/api/.env` lalu isi nilainya.
# Jangan commit file .env yang sudah berisi kredensial.
# ---------------------------------------------------------------------------

# --- OPSI 1 (sekarang): PostgreSQL portable lokal di D: ---------------------
# Jalankan cluster dulu:  .\scripts\pg.ps1 start
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sisarpras

# --- OPSI 2 (nanti): Supabase ----------------------------------------------
# Ambil dari Supabase Dashboard -> Project Settings -> Database -> Connection string.
# Pakai "Connection pooling" (port 6543) untuk serverless, atau "Direct" (port 5432).
# SSL otomatis diaktifkan karena host bukan localhost — tidak perlu ubah kode.
# DATABASE_URL=postgresql://postgres.abcdefghijklmno:KATA_SANDI@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# HTTP port untuk apps/api
PORT=8787
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
INITIAL_ADMIN_PIN=898851
