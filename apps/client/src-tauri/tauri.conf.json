{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sisarpras",
  "version": "0.1.0",
  "identifier": "id.sisarpras.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sisarpras",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8787; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:"
    }
  },
  "bundle": { "active": true, "targets": "all" },
  "plugins": {
    "sql": { "preload": ["sqlite:sisarpras.db"] }
  }
}
