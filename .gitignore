# ---------------------------------------------------------------------------
# SI SARPRAS — what must NOT enter git.
# Package manager is pnpm: pnpm-lock.yaml IS committed (never ignore it).
# ---------------------------------------------------------------------------

# --- dependencies ---------------------------------------------------------
node_modules/
.pnpm-store/
.commandcode/

# --- package-manager artefacts (this repo uses pnpm) ----------------------
package-lock.json
yarn.lock
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- build output ---------------------------------------------------------
dist/
build/
out/
*.tsbuildinfo

# --- rust / tauri ---------------------------------------------------------
# Rust build cache: ~5 GB of object files after `tauri dev`.
target/
**/src-tauri/target/
# Generated by the Tauri CLI (schemas, mobile shells).
apps/client/src-tauri/gen/
apps/client/src-tauri/.tauri/
# Desktop bundle output.
apps/client/src-tauri/bundle/
# Signing keys and certificates must never be committed.
*.pem
*.key
*.p12
*.pfx

# --- env & secrets --------------------------------------------------------
.env
.env.*
!.env.example

# --- local databases ------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- logs & temp files ----------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.orig

# --- test output (no tests yet; keep it out when they land) ---------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.vitest/

# --- editor / os ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
